  "slides": [
    {
      "brief": {
        "rhythm": "anchor"
      },
      "id": "cover-restarts",
      "layout": "Title Slide",
      "notes": "1 min. Welcome, and what is assumed.",
      "sources": [
        "outline"
      ],
      "subtitle": "What they do, and when capacity holds",
      "title": "Rolling restarts"
    },
    {
      "id": "what-it-does",
      "title": "A rolling restart replaces instances one batch at a time",
      "sources": [
        "O1"
      ],
      "brief": {
        "relation": "order",
        "focal": "s1_whatitdoes_point"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "text",
            "id": "s1_whatitdoes_point",
            "text": "One batch at a time",
            "textRole": "label"
          },
          {
            "type": "stack",
            "direction": "column",
            "gap": "tight",
            "children": [
              {
                "type": "box",
                "id": "s1_whatitdoes_p1",
                "text": "Batch: Instances are replaced one batch at a time."
              },
              {
                "type": "box",
                "id": "s1_whatitdoes_p2",
                "text": "Traffic: The app keeps serving while it restarts."
              }
            ],
            "weight": 3
          }
        ]
      },
      "connect": [
        {
          "id": "s1_whatitdoes_e1",
          "from": "s1_whatitdoes_p1",
          "to": "s1_whatitdoes_p2"
        }
      ],
      "source": "Platform documentation: restarts",
      "notes": "6 min. Walk the three-instance example."
    },
    {
      "id": "when-capacity-holds",
      "title": "Capacity holds only with more than one instance",
      "sources": [
        "O2"
      ],
      "brief": {
        "relation": "contrast",
        "focal": "s1_whencapacity_point"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "text",
            "id": "s1_whencapacity_point",
            "text": "More than one instance",
            "textRole": "label"
          },
          {
            "type": "grid",
            "columns": 2,
            "children": [
              {
                "type": "box",
                "id": "s1_whencapacity_p1",
                "text": "Several: The others carry the load."
              },
              {
                "type": "box",
                "id": "s1_whencapacity_p2",
                "text": "One: Requests are dropped while it restarts."
              }
            ],
            "weight": 3
          }
        ]
      },
      "caveat": "A single-instance app still drops requests while it restarts.",
      "notes": "7 min. Health checks start the next batch."
    },
    {
      "id": "the-objection",
      "title": "Rolling does not always mean zero downtime",
      "sources": [
        "O3"
      ],
      "brief": {
        "relation": "contrast",
        "focal": "s1_theobjection_point",
        "rhythm": "breathing"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "text",
            "id": "s1_theobjection_point",
            "text": "It depends on the instance count",
            "textRole": "label"
          },
          {
            "type": "grid",
            "columns": 2,
            "children": [
              {
                "type": "box",
                "id": "s1_theobjection_p1",
                "text": "Claim: Rolling always means zero downtime."
              },
              {
                "type": "box",
                "id": "s1_theobjection_p2",
                "text": "Correction: Only with more than one instance."
              }
            ],
            "weight": 3
          }
        ]
      },
      "notes": "7 min. Correct the claim without dismissing the customer."
    },
    {
      "id": "check-yourself",
      "title": "Check what you can now explain",
      "sources": [
        "O1",
        "O2",
        "O3"
      ],
      "brief": {
        "relation": "order",
        "focal": "s2_checkyoursel_point"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "text",
            "id": "s2_checkyoursel_point",
            "text": "Say it aloud",
            "textRole": "label"
          },
          {
            "type": "stack",
            "direction": "column",
            "gap": "tight",
            "children": [
              {
                "type": "box",
                "id": "s2_checkyoursel_p1",
                "text": "Describe: What happens to the instances?"
              },
              {
                "type": "box",
                "id": "s2_checkyoursel_p2",
                "text": "Explain: Why does one instance lose capacity?"
              }
            ],
            "weight": 3
          }
        ]
      },
      "connect": [
        {
          "id": "s2_checkyoursel_e1",
          "from": "s2_checkyoursel_p1",
          "to": "s2_checkyoursel_p2"
        }
      ],
      "notes": "3 min. One question for each point."
    },
    {
      "id": "health-checks",
      "title": "Health checks start the next batch",
      "sources": [
        "O1"
      ],
      "brief": {
        "relation": "order",
        "focal": "s2_healthchecks_p1",
        "rhythm": "breathing"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "box",
            "id": "s2_healthchecks_p1",
            "text": "Health first: A batch is replaced only once the last one is healthy."
          },
          {
            "type": "box",
            "id": "s2_healthchecks_p2",
            "text": "Wait: A failing check holds the restart."
          }
        ]
      },
      "connect": [
        {
          "id": "s2_healthchecks_e1",
          "from": "s2_healthchecks_p1",
          "to": "s2_healthchecks_p2"
        }
      ],
      "notes": "4 min. Show the check in the log."
    },
    {
      "id": "rolling-back",
      "title": "A failed batch is rolled back, not pushed on",
      "sources": [
        "O2"
      ],
      "brief": {
        "relation": "contrast",
        "focal": "s2_rollingback_p1",
        "rhythm": "breathing"
      },
      "canvas": {
        "type": "grid",
        "columns": 2,
        "children": [
          {
            "type": "box",
            "id": "s2_rollingback_p1",
            "text": "Roll back: The failed batch returns to the last version."
          },
          {
            "type": "box",
            "id": "s2_rollingback_p2",
            "text": "Push on: Carrying on would take capacity down."
          }
        ]
      },
      "notes": "3 min. One example."
    },
    {
      "brief": {
        "rhythm": "anchor"
      },
      "id": "closing-practice",
