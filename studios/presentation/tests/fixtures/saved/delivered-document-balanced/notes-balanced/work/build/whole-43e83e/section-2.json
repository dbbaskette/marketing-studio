{
  "version": 1,
  "title": "Rolling restarts",
  "direction": {
    "focal": "headingPrimary",
    "meanings": {
      "accentAqua": "Example Platform: the product this deck is about"
    },
    "motif": "A strip on each card says what it is about.",
    "neutral": "canvasSecondary"
  },
  "slides": [
    {
      "id": "check-yourself",
      "title": "Check what you can now explain",
      "sources": [
        "O1",
        "O2",
        "O3"
      ],
      "brief": {
        "relation": "order",
        "focal": "s2_checkyoursel_point"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "text",
            "id": "s2_checkyoursel_point",
            "text": "Say it aloud",
            "textRole": "label"
          },
          {
            "type": "stack",
            "direction": "column",
            "gap": "tight",
            "children": [
              {
                "type": "box",
                "id": "s2_checkyoursel_p1",
                "text": "Describe: What happens to the instances?"
              },
              {
                "type": "box",
                "id": "s2_checkyoursel_p2",
                "text": "Explain: Why does one instance lose capacity?"
              }
            ],
            "weight": 3
          }
        ]
      },
      "connect": [
        {
          "id": "s2_checkyoursel_e1",
          "from": "s2_checkyoursel_p1",
          "to": "s2_checkyoursel_p2"
        }
      ],
      "notes": "3 min. One question for each point."
    },
    {
      "id": "health-checks",
      "title": "Health checks start the next batch",
      "sources": [
        "O1"
      ],
      "brief": {
        "relation": "order",
        "focal": "s2_healthchecks_p1",
        "rhythm": "breathing"
      },
      "canvas": {
        "type": "stack",
        "direction": "column",
        "gap": "tight",
        "children": [
          {
            "type": "box",
            "id": "s2_healthchecks_p1",
            "text": "Health first: A batch is replaced only once the last one is healthy."
          },
          {
            "type": "box",
            "id": "s2_healthchecks_p2",
            "text": "Wait: A failing check holds the restart."
          }
        ]
      },
      "connect": [
        {
          "id": "s2_healthchecks_e1",
          "from": "s2_healthchecks_p1",
          "to": "s2_healthchecks_p2"
        }
      ],
      "notes": "4 min. Show the check in the log."
    },
    {
      "id": "rolling-back",
      "title": "A failed batch is rolled back, not pushed on",
      "sources": [
        "O2"
      ],
      "brief": {
        "relation": "contrast",
        "focal": "s2_rollingback_p1",
        "rhythm": "breathing"
      },
      "canvas": {
        "type": "grid",
        "columns": 2,
        "children": [
          {
            "type": "box",
            "id": "s2_rollingback_p1",
            "text": "Roll back: The failed batch returns to the last version."
          },
          {
            "type": "box",
            "id": "s2_rollingback_p2",
            "text": "Push on: Carrying on would take capacity down."
          }
        ]
      },
      "notes": "3 min. One example."
    }
  ]
}
