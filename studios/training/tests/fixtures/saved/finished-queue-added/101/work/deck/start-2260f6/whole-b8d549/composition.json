{"version": 1, "title": "Rolling restarts", "direction": {"focal": "headingPrimary", "neutral": "canvasSecondary"}, "slides": [{"brief": {"rhythm": "anchor"}, "id": "cover-restarts", "layout": "Title slide", "notes": "1 min. Welcome, and what is assumed.", "sources": ["outline"], "subtitle": "What they do, and when capacity holds", "title": "Rolling restarts"}, {"id": "what-it-does", "title": "A rolling restart replaces instances one batch at a time", "sources": ["O1"], "brief": {"relation": "order", "focal": "s1_what_it_does_t1", "rhythm": "anchor"}, "canvas": {"type": "stack", "direction": "column", "children": [{"type": "text", "id": "s1_what_it_does_h1", "text": "Batch", "textRole": "label"}, {"type": "text", "id": "s1_what_it_does_t1", "text": "Instances are replaced one batch at a time."}, {"type": "text", "id": "s1_what_it_does_h2", "text": "Traffic", "textRole": "label"}, {"type": "text", "id": "s1_what_it_does_t2", "text": "The app keeps serving while it restarts."}]}, "notes": "6 min. Walk the three-instance example.", "source": "Platform documentation: restarts"}, {"id": "when-capacity-holds", "title": "Capacity holds only with more than one instance", "sources": ["O2"], "brief": {"relation": "order", "focal": "s1_when_capacity_holds_t1", "rhythm": "anchor"}, "canvas": {"type": "stack", "direction": "column", "children": [{"type": "text", "id": "s1_when_capacity_holds_h1", "text": "Several", "textRole": "label"}, {"type": "text", "id": "s1_when_capacity_holds_t1", "text": "The others carry the load."}, {"type": "text", "id": "s1_when_capacity_holds_h2", "text": "One", "textRole": "label"}, {"type": "text", "id": "s1_when_capacity_holds_t2", "text": "Requests are dropped while it restarts."}]}, "notes": "7 min. Health checks start the next batch.", "caveat": "A single-instance app still drops requests while it restarts."}, {"id": "the-objection", "title": "Rolling does not always mean zero downtime", "sources": ["O3"], "brief": {"relation": "order", "focal": "s2_the_objection_t1", "rhythm": "anchor"}, "canvas": {"type": "stack", "direction": "column", "children": [{"type": "text", "id": "s2_the_objection_h1", "text": "Claim", "textRole": "label"}, {"type": "text", "id": "s2_the_objection_t1", "text": "Rolling always means zero downtime."}, {"type": "text", "id": "s2_the_objection_h2", "text": "Correction", "textRole": "label"}, {"type": "text", "id": "s2_the_objection_t2", "text": "Only with more than one instance."}]}, "notes": "7 min. Correct the claim without dismissing the customer."}, {"id": "check-yourself", "title": "Check what you can now explain", "sources": ["O1", "O2", "O3"], "brief": {"relation": "order", "focal": "s2_check_yourself_t1", "rhythm": "anchor"}, "canvas": {"type": "stack", "direction": "column", "children": [{"type": "text", "id": "s2_check_yourself_h1", "text": "Describe", "textRole": "label"}, {"type": "text", "id": "s2_check_yourself_t1", "text": "What happens to the instances?"}, {"type": "text", "id": "s2_check_yourself_h2", "text": "Explain", "textRole": "label"}, {"type": "text", "id": "s2_check_yourself_t2", "text": "Why does one instance lose capacity?"}]}, "notes": "3 min. One question for each objective."}, {"brief": {"rhythm": "anchor"}, "id": "closing-practice", "layout": "Closing with title", "notes": "1 min. Point to the practice scenario.", "sources": ["outline"], "title": "Next: practice the objection"}]}